.overview-card {
  background: linear-gradient(135deg, #4A90D9, #6bb3f0);
  color: #fff;
}

.month-label {
  font-size: 28rpx;
  opacity: 0.8;
  margin-bottom: 16rpx;
}

.overview-row {
  display: flex;
  justify-content: space-between;
}

.overview-item {
  flex: 1;
  text-align: center;
}

.overview-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.overview-amount {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
}

.overview-card .text-expense,
.overview-card .text-income,
.overview-card .text-primary {
  color: #fff;
}

.action-btns {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.summary-list .summary-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.summary-list .summary-item:last-child {
  border-bottom: none;
}

.summary-name {
  font-size: 28rpx;
}

.summary-amount {
  font-size: 28rpx;
  font-weight: bold;
}

.record-list .record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-list .record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  flex-direction: column;
}

.record-category {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.record-meta {
  font-size: 22rpx;
}

.record-amount {
  font-size: 30rpx;
  font-weight: bold;
}

.page-loading {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}
