.overview-card {
  background: linear-gradient(135deg, #4A90D9, #6bb3f0);
  color: #fff;
}

.month-label {
  font-size: 28rpx;
  opacity: 0.8;
  margin-bottom: 16rpx;
}

.overview-row {
  display: flex;
  justify-content: space-between;
}

.overview-item {
  flex: 1;
  text-align: center;
}

.overview-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.overview-amount {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
}

.overview-card .text-expense,
.overview-card .text-income,
.overview-card .text-primary {
  color: #fff;
}

.action-btns {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

/* Account summary - expandable */
.summary-item {
  padding: 8rpx 0;
}

.summary-item:last-child {
  border-bottom: none;
}

.summary-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.summary-left {
  display: flex;
  flex-direction: column;
}

.summary-name {
  font-size: 28rpx;
  font-weight: 500;
}

.summary-count {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.summary-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.summary-expense, .summary-income {
  font-size: 26rpx;
  font-weight: bold;
}

.summary-amount {
  font-size: 28rpx;
  font-weight: bold;
}

/* Expanded records */
.account-records {
  margin-left: 16rpx;
  padding: 8rpx 0 16rpx 16rpx;
  border-left: 2rpx solid #4A90D9;
  background: #fafafa;
  border-radius: 0 8rpx 8rpx 0;
}

.records-loading, .records-empty {
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 0;
  text-align: center;
}

.account-records .record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
}

.account-records .record-item:last-child {
  border-bottom: none;
}

/* General record list */
.record-list .record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-list .record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  flex-direction: column;
}

.record-category {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.record-meta {
  font-size: 22rpx;
}

.record-amount {
  font-size: 30rpx;
  font-weight: bold;
}

.page-loading {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}