<view class="container">
  <!-- 月度概览卡片 -->
  <view class="card overview-card">
    <view class="month-label">{{month}}</view>
    <view class="overview-row">
      <view class="overview-item">
        <text class="overview-label">支出</text>
        <text class="overview-amount text-expense">-{{totalExpense}}</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">收入</text>
        <text class="overview-amount text-income">+{{totalIncome}}</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">结余</text>
        <text class="overview-amount text-primary">{{balance}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷按钮 -->
  <view class="action-btns">
    <van-button size="small" type="primary" plain bind:click="goSearchPage" custom-class="action-btn">新增统计项</van-button>
    <van-button size="small" type="info" plain bind:click="goSavedPage" custom-class="action-btn">已保存统计</van-button>
    <van-button size="small" type="default" plain bind:click="goCompositePage" custom-class="action-btn">复合统计</van-button>
  </view>

  <!-- 按类目汇总 -->
  <view class="card" wx:if="{{categorySummary.length}}">
    <view class="section-title">按类目汇总</view>
    <view class="summary-list">
      <view class="summary-item" wx:for="{{categorySummary}}" wx:key="name">
        <text class="summary-name">{{item.name}}</text>
        <text class="summary-amount {{item.type === 1 ? 'text-expense' : 'text-income'}}">{{item.type === 1 ? '-' : '+'}}{{item.amount}}</text>
      </view>
    </view>
  </view>

  <!-- 按账本汇总 -->
  <view class="card" wx:if="{{accountSummary.length}}">
    <view class="section-title">按账本汇总</view>
    <view class="summary-list">
      <view class="summary-item" wx:for="{{accountSummary}}" wx:key="name">
        <text class="summary-name">{{item.name}}</text>
        <text class="summary-amount text-primary">{{item.amount}}</text>
      </view>
    </view>
  </view>

  <!-- 最近记录 -->
  <view class="card">
    <view class="section-title">最近记录</view>
    <view wx:if="{{!recentRecords.length && !loading}}">
      <van-empty description="暂无记录" />
    </view>
    <view class="record-list">
      <view class="record-item" wx:for="{{recentRecords}}" wx:key="id" bind:tap="goRecordDetail" data-id="{{item.id}}" data-type="{{item.type}}">
        <view class="record-left">
          <text class="record-category">{{item.category_name}}</text>
          <text class="record-meta text-muted">{{item.record_date}} {{item.account_name}}</text>
        </view>
        <text class="record-amount {{item.type === 1 ? 'text-expense' : 'text-income'}}">
          {{item.type === 1 ? '-' : '+'}}{{item.amount}}
        </text>
      </view>
    </view>
  </view>

  <van-loading wx:if="{{loading}}" size="24px" vertical custom-class="page-loading">加载中...</van-loading>
</view>
