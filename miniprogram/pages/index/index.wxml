<view class="container">
  <view class="card overview-card">
    <view class="month-label">{{month}}</view>
    <view class="overview-row">
      <view class="overview-item">
        <text class="overview-label">Expense</text>
        <text class="overview-amount text-expense">-{{totalExpense}}</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">Income</text>
        <text class="overview-amount text-income">+{{totalIncome}}</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">Balance</text>
        <text class="overview-amount text-primary">{{balance}}</text>
      </view>
    </view>
  </view>

  <view class="action-btns">
    <van-button size="small" type="primary" plain bindclick="goSearchPage" custom-class="action-btn">New Stat</van-button>
    <van-button size="small" type="info" plain bindclick="goSavedPage" custom-class="action-btn">Saved</van-button>
    <van-button size="small" type="default" plain bindclick="goCompositePage" custom-class="action-btn">Composite</van-button>
  </view>

  <view class="card" wx:if="{{accountSummary.length}}">
    <view class="section-title">By Account</view>
    <view class="summary-list">
      <view class="summary-item" wx:for="{{accountSummary}}" wx:key="*this"
            bindtap="goAccountDetail" data-name="{{item.name}}" data-count="{{item.count}}" data-amount="{{item.amount}}">
        <view class="summary-left">
          <text class="summary-name">{{item.name}}</text>
          <text class="summary-count text-muted">{{item.count}} records</text>
        </view>
        <text class="summary-amount {{item.type === 1 ? 'text-expense' : 'text-income'}}">
          {{item.type === 1 ? '-' : '+'}}{{item.amount}}
        </text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{categorySummary.length}}">
    <view class="section-title">By Category</view>
    <view class="summary-list">
      <view class="summary-item" wx:for="{{categorySummary}}" wx:key="*this">
        <view class="summary-left">
          <text class="summary-name">{{item.name}}</text>
          <text class="summary-count text-muted">{{item.count}} records</text>
        </view>
        <text class="summary-amount {{item.type === 1 ? 'text-expense' : 'text-income'}}">
          {{item.type === 1 ? '-' : '+'}}{{item.amount}}
        </text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">Recent Records</view>
    <view wx:if="{{!recentRecords.length && !loading}}">
      <van-empty description="No records" />
    </view>
    <view class="record-list">
      <view class="record-item" wx:for="{{recentRecords}}" wx:key="id" bindtap="goRecordDetail" data-id="{{item.id}}" data-type="{{item.type}}">
        <view class="record-left">
          <text class="record-category">{{item.category_name || 'Uncategorized'}}</text>
          <text class="record-meta text-muted">{{item.record_date}} {{item.account_name || ''}}</text>
        </view>
        <text class="record-amount {{item.type === 1 ? 'text-expense' : 'text-income'}}">
          {{item.type === 1 ? '-' : '+'}}{{item.amount}}
        </text>
      </view>
    </view>
  </view>

  <van-loading wx:if="{{loading}}" size="24px" vertical custom-class="page-loading">Loading...</van-loading>
</view>