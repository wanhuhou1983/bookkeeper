.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.date-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-picker {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.date-sep {
  color: #999;
  font-size: 26rpx;
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-section:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-tag {
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #333;
}

.filter-tag.active {
  background: #4A90D9;
  color: #fff;
}

.result-card {
  margin-top: 20rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.result-label {
  font-size: 28rpx;
  color: #666;
}

.result-amount {
  font-size: 36rpx;
  font-weight: bold;
}

.result-count {
  font-size: 30rpx;
  font-weight: bold;
}

.save-btn {
  margin-top: 16rpx;
}
