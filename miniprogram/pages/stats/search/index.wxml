<scroll-view scroll-y="true" style="height:100vh;">
<view class="container">
  <view class="card">
    <view class="section-title">时间范围</view>
    <view class="date-range">
      <picker mode="date" value="{{form.date_start}}" bindchange="onDateStartChange">
        <view class="date-picker">{{form.date_start || '开始日期'}}</view>
      </picker>
      <text class="date-sep">至</text>
      <picker mode="date" value="{{form.date_end}}" bindchange="onDateEndChange">
        <view class="date-picker">{{form.date_end || '结束日期'}}</view>
      </picker>
    </view>
  </view>

  <view class="card">
    <view class="section-title">筛选条件（多选）</view>

    <view class="filter-section" wx:if="{{accounts.length}}">
      <view class="filter-label">账本</view>
      <view class="filter-tags">
        <view class="filter-tag {{form.account_ids.indexOf(item.id) >= 0 ? 'active' : ''}}"
              wx:for="{{accounts}}" wx:key="id"
              bind:tap="onAccountToggle" data-id="{{item.id}}">
          {{item.name}}
        </view>
      </view>
    </view>

    <view class="filter-section" wx:if="{{categories.length}}">
      <view class="filter-label">分类</view>
      <view class="filter-tags">
        <view class="filter-tag {{form.category_ids.indexOf(item.id) >= 0 ? 'active' : ''}}"
              wx:for="{{categories}}" wx:key="id"
              bind:tap="onCategoryToggle" data-id="{{item.id}}">
          {{item.name}}
        </view>
      </view>
    </view>

    <view class="filter-section" wx:if="{{channels.length}}">
      <view class="filter-label">渠道</view>
      <view class="filter-tags">
        <view class="filter-tag {{form.channel_ids.indexOf(item.id) >= 0 ? 'active' : ''}}"
              wx:for="{{channels}}" wx:key="id"
              bind:tap="onChannelToggle" data-id="{{item.id}}">
          {{item.name}}
        </view>
      </view>
    </view>

    <view class="filter-section" wx:if="{{banks.length}}">
      <view class="filter-label">银行</view>
      <view class="filter-tags">
        <view class="filter-tag {{form.bank_ids.indexOf(item.id) >= 0 ? 'active' : ''}}"
              wx:for="{{banks}}" wx:key="id"
              bind:tap="onBankToggle" data-id="{{item.id}}">
          {{item.name}}
        </view>
      </view>
    </view>
  </view>

  <van-button type="primary" block loading="{{submitting}}" bind:click="onQuery">查询</van-button>

  <view class="card result-card" wx:if="{{hasResult}}">
    <view class="result-row">
      <text class="result-label">总金额</text>
      <text class="result-amount text-primary">¥{{resultAmount}}</text>
    </view>
    <view class="result-row">
      <text class="result-label">笔数</text>
      <text class="result-count">{{resultCount}} 笔</text>
    </view>
    <van-button size="small" type="info" plain bind:click="onSaveClick" custom-class="save-btn">保存为统计项</van-button>
  </view>
</view>
</scroll-view>

<van-dialog use-slot show="{{showSaveDialog}}" title="保存统计项" show-cancel-button confirm-button-text="保存" bind:confirm="onSaveConfirm" bind:cancel="onSaveCancel">
  <van-field value="{{saveName}}" placeholder="请输入统计项名称" border="{{true}}" bind:change="onSaveNameInput" />
</van-dialog>