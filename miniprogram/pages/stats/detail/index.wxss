.detail-header {
  margin-bottom: 20rpx;
}

.detail-name {
  font-size: 34rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 4rpx;
}

.detail-type {
  font-size: 24rpx;
}

.detail-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.detail-total-label {
  font-size: 28rpx;
  color: #666;
}

.detail-total-amount {
  font-size: 40rpx;
  font-weight: bold;
}

.detail-count {
  font-size: 26rpx;
  color: #999;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.filter-info {
  font-size: 26rpx;
  padding: 8rpx 0;
  line-height: 1.6;
}

.comp-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comp-item:last-child {
  border-bottom: none;
}

.comp-operator {
  font-size: 32rpx;
  font-weight: bold;
  width: 40rpx;
}

.comp-name {
  flex: 1;
  font-size: 28rpx;
}

.comp-amount {
  font-size: 28rpx;
  font-weight: bold;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  flex-direction: column;
}

.record-category {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.record-meta {
  font-size: 22rpx;
}

.record-amount {
  font-size: 30rpx;
  font-weight: bold;
}

.page-loading {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}
