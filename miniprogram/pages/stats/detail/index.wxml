<view class="container">
  <van-loading wx:if="{{loading}}" size="24px" vertical custom-class="page-loading">Loading...</van-loading>

  <view wx:if="{{detail && !loading}}">
    <view class="card">
      <view class="detail-header">
        <text class="detail-name">{{detail.name}}</text>
        <text class="detail-type text-muted">{{type === 'composite' ? 'Composite' : 'Saved Search'}}</text>
      </view>
      <view class="detail-total">
        <text class="detail-total-label">Total</text>
        <text class="detail-total-amount text-primary">CNY {{detail.result_cache || '0.00'}}</text>
      </view>
      <view class="detail-count" wx:if="{{detail.count}}">
        Count: {{detail.count}}
      </view>
    </view>

    <view class="card" wx:if="{{detail.filters && type === 'saved'}}">
      <view class="section-title">Filters</view>
      <view class="filter-info" wx:if="{{detail.filters.date_from || detail.filters.date_to}}">
        <text class="text-muted">Date: </text>
        <text>{{detail.filters.date_from || 'Any'}} ~ {{detail.filters.date_to || 'Any'}}</text>
      </view>
      <view class="filter-info">
        <text class="text-expense">Expense: {{expenseSummary}}</text>
        <text class="text-income" style="margin-left: 20rpx;">Income: {{incomeSummary}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{detail.items && type === 'composite'}}">
      <view class="section-title">Items</view>
      <view class="comp-item" wx:for="{{detail.items}}" wx:key="search_id">
        <text class="comp-operator {{item.operator === '+' ? 'text-income' : 'text-expense'}}">{{item.operator}}</text>
        <text class="comp-name">{{item.name || 'Search'}}</text>
        <text class="comp-amount text-primary">CNY {{item.result_cache || '0.00'}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{detail.records && detail.records.length}}">
      <view class="section-title">Records</view>
      <view class="record-item" wx:for="{{detail.records}}" wx:key="id" wx:for-item="rec" bindtap="goRecordDetail" data-id="{{rec.id}}" data-type="{{rec.type}}">
        <view class="record-left">
          <text class="record-category">{{rec.category_name || 'Uncategorized'}}</text>
          <text class="record-meta text-muted">{{rec.record_date}} {{rec.account_name || ''}}</text>
        </view>
        <text class="record-amount {{rec.type === 1 ? 'text-expense' : 'text-income'}}">
          {{rec.type === 1 ? '-' : '+'}}{{rec.amount}}
        </text>
      </view>
    </view>
  </view>

  <view wx:if="{{!detail && !loading}}">
    <van-empty description="No data" />
  </view>
</view>