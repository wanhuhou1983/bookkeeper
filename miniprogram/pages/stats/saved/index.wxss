.saved-item {
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.saved-main {
  flex: 1;
}

.saved-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.saved-name {
  font-size: 30rpx;
  font-weight: bold;
}

.saved-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.saved-summary {
  font-size: 24rpx;
  line-height: 1.6;
}

.saved-delete {
  margin-left: 20rpx;
  padding: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-loading {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}