.saved-item {
  margin-bottom: 20rpx;
}

.saved-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.saved-name {
  font-size: 30rpx;
  font-weight: bold;
}

.saved-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.saved-summary {
  font-size: 24rpx;
  line-height: 1.6;
}

.page-loading {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}
