<view class="container">
  <view wx:if="{{!list.length && !loading}}">
    <van-empty description="暂无已保存的统计项" />
  </view>

  <view class="saved-list" wx:if="{{list.length}}">
    <view class="card saved-item"
          wx:for="{{list}}" wx:key="id"
          bind:tap="goDetail" data-id="{{item.id}}"
          bindlongpress="onLongPress" data-id="{{item.id}}" data-name="{{item.name}}">
      <view class="saved-header">
        <text class="saved-name">{{item.name}}</text>
        <text class="saved-amount text-primary">¥{{item.total || '0.00'}}</text>
      </view>
      <view class="saved-summary text-muted" wx:if="{{item.summary}}">
        {{item.summary}}
      </view>
      <view class="saved-summary text-muted" wx:if="{{item.count}}">
        共 {{item.count}} 笔
      </view>
    </view>
  </view>

  <van-loading wx:if="{{loading}}" size="24px" vertical custom-class="page-loading">加载中...</van-loading>
</view>

<!-- 重命名弹窗 -->
<van-dialog
  use-slot
  show="{{showRename}}"
  title="重命名"
  show-cancel-button
  confirm-button-text="确定"
  bind:confirm="onRenameConfirm"
  bind:cancel="onRenameCancel"
>
  <van-field value="{{renameName}}" placeholder="请输入新名称" border="{{true}}" bind:change="onRenameInput" />
</van-dialog>
