<view class="container">
  <view class="record-list" wx:if="{{records.length}}">
    <view class="list-item" wx:for="{{records}}" wx:key="id" bind:tap="goEdit" data-id="{{item.id}}">
      <view class="item-left">
        <view class="item-top">
          <text class="item-category">{{item.category_name || '未分类'}}</text>
          <text class="tag income tag-small">收入</text>
        </view>
        <view class="item-bottom text-muted">
          <text>{{item.record_date || item.date}}</text>
          <text wx:if="{{item.account_name}}" class="ml-10">{{item.account_name}}</text>
        </view>
        <view class="tag-row">
            <text class="tag tag-account" wx:if="{{item.account_name}}">{{item.account_name}}</text>
            <text class="tag tag-category" wx:if="{{item.category_name}}">{{item.category_name}}</text>
            <text class="tag tag-channel" wx:if="{{item.channel_name}}">{{item.channel_name}}</text>
            <text class="tag tag-bank" wx:if="{{item.bank_name}}">{{item.bank_name}}</text>
          </view>
        <view class="item-bottom text-muted" wx:if="{{item.note}}">
          <text>{{item.note}}</text>
        </view>
      </view>
      <text class="item-amount text-income">+¥{{item.amount}}</text>
    </view>
  </view>

  <view wx:if="{{!records.length && !loading}}">
    <van-empty description="暂无收入记录" />
  </view>

  <van-loading wx:if="{{loading}}" size="24px" vertical custom-class="page-loading">加载中...</van-loading>

  <view wx:if="{{!hasMore && records.length}}" class="no-more text-muted">没有更多了</view>
</view>

<view class="fab-btn income" bind:tap="goAdd">+</view>