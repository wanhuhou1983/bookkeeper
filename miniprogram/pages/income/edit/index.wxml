<view class="container">
  <view class="amount-card card">
    <text class="amount-label">收入金额</text>
    <view class="amount-input-wrap">
      <text class="amount-prefix text-income">¥</text>
      <input class="amount-input text-income" type="digit" placeholder="0.00" value="{{form.amount}}" bindinput="onAmountInput" focus="{{!isEdit}}" />
    </view>
  </view>

  <van-cell-group>
    <van-cell title="日期" is-link value="{{form.date || '请选择'}}" bind:click="noop">
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange" slot="extra">
        <view class="picker-trigger"></view>
      </picker>
    </van-cell>

    <van-cell title="账本">
      <view slot="value" class="account-tags">
        <view class="account-tag" wx:for="{{selectedAccounts}}" wx:key="id" wx:for-item="acc">
          <text class="account-tag-name">{{acc.name}}</text>
          <van-icon name="cross" size="14px" color="#999" bind:click="onAccountRemove" data-index="{{index}}" custom-class="account-tag-remove" />
        </view>
        <view class="account-tag account-add" bind:tap="onAccountPickerOpen">
          <van-icon name="plus" size="16px" color="#4A90D9" />
        </view>
      </view>
    </van-cell>

    <van-cell title="分类" is-link value="{{categoryIndex >= 0 ? categoryNames[categoryIndex] : '请选择'}}">
      <picker range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryConfirm" slot="extra">
        <view class="picker-trigger"></view>
      </picker>
    </van-cell>

    <van-cell title="渠道" is-link value="{{channelIndex >= 0 ? channelNames[channelIndex] : '可选'}}">
      <picker range="{{channelNames}}" value="{{channelIndex}}" bindchange="onChannelConfirm" slot="extra">
        <view class="picker-trigger"></view>
      </picker>
    </van-cell>

    <van-cell title="银行" is-link value="{{bankIndex >= 0 ? bankNames[bankIndex] : '可选'}}">
      <picker range="{{bankNames}}" value="{{bankIndex}}" bindchange="onBankConfirm" slot="extra">
        <view class="picker-trigger"></view>
      </picker>
    </van-cell>

    <van-field label="备注" value="{{form.note}}" placeholder="选填" border="{{true}}" bind:change="onNoteInput" />
  </van-cell-group>

  <view class="submit-wrap">
    <van-button type="primary" block loading="{{submitting}}" disabled="{{submitting}}" bind:click="onSubmit">
      {{isEdit ? '保存修改' : '记一笔收入'}}
    </van-button>
  </view>
</view>

<van-popup show="{{showAccountPicker}}" position="bottom" bind:close="onAccountPickerClose" custom-style="height: 50%;">
  <view class="picker-header">
    <text class="picker-title">选择账本</text>
    <van-icon name="cross" size="20px" bind:click="onAccountPickerClose" />
  </view>
  <view class="picker-list">
    <view class="picker-item" wx:for="{{availableAccounts}}" wx:key="id" bind:tap="onAccountSelect" data-index="{{index}}">
      <text>{{item.name}}</text>
    </view>
    <view wx:if="{{!availableAccounts.length}}" class="text-muted" style="text-align:center;padding:40rpx;">没有更多账本了</view>
  </view>
</van-popup>