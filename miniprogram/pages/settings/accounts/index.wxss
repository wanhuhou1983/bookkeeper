.list-card {
  padding: 0;
}

.manage-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.manage-item:last-child {
  border-bottom: none;
}

.manage-name {
  font-size: 30rpx;
}

.add-btn-wrap {
  margin-top: 40rpx;
}

.page-loading {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}
