<scroll-view scroll-y="true" style="height:100vh;">
<view class="container">
  <view wx:if="{{!list.length && !loading}}"><van-empty description="No accounts" /></view>
  <view class="card" wx:if="{{list.length}}">
    <view class="section-title">Accounts</view>
    <view class="manage-item" wx:for="{{list}}" wx:key="id">
      <view class="manage-left"><text class="manage-name">{{item.name}}</text><text class="sys-badge" wx:if="{{item.is_system}}">System</text></view>
      <view class="manage-actions">
        <van-icon name="edit" size="18px" color="#4A90D9" bindclick="onEditClick" data-id="{{item.id}}" data-name="{{item.name}}" wx:if="{{!item.is_system}}" />
        <van-icon name="delete-o" size="18px" color="#ee0a24" bindclick="onDelete" data-id="{{item.id}}" data-name="{{item.name}}" wx:if="{{!item.is_system}}" />
      </view>
    </view>
  </view>
  <view class="add-btn-wrap" wx:if="{{list.length}}"><van-button type="primary" plain block icon="plus" bindclick="onAddClick">Add Account</van-button></view>
  <van-loading wx:if="{{loading}}" size="24px" vertical custom-class="page-loading">Loading...</van-loading>
</view>
</scroll-view>

<van-dialog use-slot show="{{showAdd}}" title="New Account" show-cancel-button confirm-button-text="Add" bindconfirm="onAddConfirm" bindcancel="onAddCancel">
  <van-field value="{{newName}}" placeholder="Account name" border="{{true}}" bindchange="onNameInput" />
</van-dialog>

<van-dialog use-slot show="{{showEdit}}" title="Rename Account" show-cancel-button confirm-button-text="Save" bindconfirm="onEditConfirm" bindcancel="onEditCancel">
  <van-field value="{{editName}}" placeholder="Account name" border="{{true}}" bindchange="onEditNameInput" />
</van-dialog>
