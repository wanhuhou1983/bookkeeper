.list-card {
  padding: 0;
}

.manage-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.manage-item:last-child {
  border-bottom: none;
}

.manage-name {
  font-size: 30rpx;
}

.system-tag {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.add-btn-wrap {
  margin-top: 40rpx;
}

.page-loading {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}

.preset-wrap {
  padding: 30rpx;
  text-align: center;
}

.preset-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
}