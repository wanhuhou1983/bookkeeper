<scroll-view scroll-y="true" style="height:100vh;">
<view class="container">
  <view wx:if="{{!list.length && !loading}}">
    <van-empty description="No channels" />
    <view class="preset-wrap" wx:if="{{showPreset}}">
      <van-button type="primary" block bindclick="initPresets">Init Presets</van-button>
    </view>
  </view>

  <view class="card" wx:if="{{list.length}}">
    <view class="section-title">Channels</view>
    <view class="manage-item" wx:for="{{list}}" wx:key="id">
      <view class="manage-left">
        <text class="manage-name">{{item.name}}</text>
        <text class="sys-badge" wx:if="{{item.is_system}}">System</text>
      </view>
      <view class="manage-actions">
        <van-icon name="edit" size="18px" color="#4A90D9" bindclick="onEditClick" data-id="{{item.id}}" data-name="{{item.name}}" wx:if="{{!item.is_system}}" />
        <van-icon name="delete-o" size="18px" color="#ee0a24" bindclick="onDelete" data-id="{{item.id}}" data-name="{{item.name}}" wx:if="{{!item.is_system}}" />
      </view>
    </view>
  </view>

  <view class="add-btn-wrap" wx:if="{{list.length}}">
    <van-button type="primary" plain block icon="plus" bindclick="onAddClick">Add Channel</van-button>
  </view>
  <van-loading wx:if="{{loading}}" size="24px" vertical custom-class="page-loading">Loading...</van-loading>
</view>
</scroll-view>

<van-dialog use-slot show="{{showAdd}}" title="New Channel" show-cancel-button confirm-button-text="Add" bindconfirm="onAddConfirm" bindcancel="onAddCancel">
  <van-field value="{{newName}}" placeholder="Channel name" border="{{true}}" bindchange="onNameInput" />
</van-dialog>

<van-dialog use-slot show="{{showEdit}}" title="Rename Channel" show-cancel-button confirm-button-text="Save" bindconfirm="onEditConfirm" bindcancel="onEditCancel">
  <van-field value="{{editName}}" placeholder="Channel name" border="{{true}}" bindchange="onEditNameInput" />
</van-dialog>
