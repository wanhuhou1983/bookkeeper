<scroll-view scroll-y="true" style="height:100vh;">
<view class="container">
  <view wx:if="{{!expenseList.length && !incomeList.length && !loading}}">
    <van-empty description="No categories" />
    <view class="preset-wrap" wx:if="{{showPreset}}">
      <van-button type="primary" block bindclick="initPresets">Init Presets</van-button>
      <text class="preset-hint">
        Expense: Shop, Transfer, Bonus, Interest
        Income: Transfer, Salary, Bonus, Interest, Profit, Loan
      </text>
    </view>
  </view>

  <view class="card" wx:if="{{expenseList.length}}">
    <view class="section-title">Expense Categories</view>
    <view class="manage-item" wx:for="{{expenseList}}" wx:key="id">
      <text class="manage-name">{{item.name}}</text>
      <van-icon name="delete-o" size="20px" color="#ee0a24" bindclick="onDelete" data-id="{{item.id}}" data-name="{{item.name}}" />
    </view>
  </view>

  <view class="card" wx:if="{{incomeList.length}}" style="margin-top: 16rpx;">
    <view class="section-title">Income Categories</view>
    <view class="manage-item" wx:for="{{incomeList}}" wx:key="id">
      <text class="manage-name">{{item.name}}</text>
      <van-icon name="delete-o" size="20px" color="#ee0a24" bindclick="onDelete" data-id="{{item.id}}" data-name="{{item.name}}" />
    </view>
  </view>

  <view class="add-btn-wrap" wx:if="{{expenseList.length || incomeList.length}}">
    <van-button type="primary" plain block icon="plus" bindclick="onAddClick">Add Category</van-button>
  </view>

  <van-loading wx:if="{{loading}}" size="24px" vertical custom-class="page-loading">Loading...</van-loading>
</view>
</scroll-view>

<van-dialog use-slot show="{{showAdd}}" title="New Category" show-cancel-button confirm-button-text="Add" bindconfirm="onAddConfirm" bindcancel="onAddCancel">
  <view class="dialog-form">
    <van-field value="{{newName}}" placeholder="Category name" border="{{true}}" bindchange="onNameInput" />
    <view class="type-row">
      <text class="dialog-label">Type</text>
      <van-radio-group value="{{newType}}" bindchange="onTypeChange" direction="horizontal" custom-class="type-radio">
        <van-radio name="1" label-position="left">Expense</van-radio>
        <van-radio name="2" label-position="left">Income</van-radio>
      </van-radio-group>
    </view>
  </view>
</van-dialog>

<van-dialog use-slot show="{{showEdit}}" title="Rename Category" show-cancel-button confirm-button-text="Save" bindconfirm="onEditConfirm" bindcancel="onEditCancel">
  <van-field value="{{editName}}" placeholder="Category name" border="{{true}}" bindchange="onEditNameInput" />
</van-dialog>