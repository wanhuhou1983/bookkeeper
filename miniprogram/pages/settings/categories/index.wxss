.list-card {
  padding: 0;
}

.manage-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.manage-item:last-child {
  border-bottom: none;
}

.manage-name {
  font-size: 30rpx;
}

.system-tag {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.add-btn-wrap {
  padding: 16rpx 0;
}

.page-loading {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}

/* 分类类型选择行 */
.type-row {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.dialog-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.dialog-form {
  padding: 0;
}

.type-radio {
  flex: 1;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding: 24rpx 30rpx 16rpx;
}

.preset-wrap {
  padding: 0 30rpx;
  text-align: center;
}

.preset-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
  line-height: 1.6;
}