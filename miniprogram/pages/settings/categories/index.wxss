.manage-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.manage-item:last-child {
  border-bottom: none;
}

.manage-name {
  font-size: 30rpx;
}

.sys-badge {
  font-size: 20rpx;
  color: #999;
  background: #f0f0f0;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-left: 8rpx;
}

.manage-left {
  display: flex;
  align-items: center;
}

.manage-actions {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.preset-wrap {
  text-align: center;
  margin-top: 40rpx;
}

.preset-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
  white-space: pre-line;
  line-height: 1.8;
}

.dialog-form {
  padding: 0;
}

.type-row {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
}

.dialog-label {
  font-size: 28rpx;
  margin-right: 20rpx;
}

.type-radio {
  --radio-label-margin: 0 20rpx 0 0;
}

.add-btn-wrap {
  margin-top: 30rpx;
}

.page-loading {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}