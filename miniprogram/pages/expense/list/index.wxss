.total-card {
  text-align: center;
  padding: 30rpx;
}

.total-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.total-amount {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
}

.record-list {
  margin-top: 10rpx;
}

.item-left {
  flex: 1;
  min-width: 0;
}

.item-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.item-category {
  font-size: 30rpx;
  font-weight: 500;
}

.tag-small {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
}

.item-bottom {
  font-size: 24rpx;
}

.ml-10 {
  margin-left: 10rpx;
}

.item-amount {
  font-size: 32rpx;
  font-weight: bold;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.page-loading {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
}
.tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  color: #fff;
}
.tag-account { background-color: #4A90D9; }
.tag-category { background-color: #F5A623; }
.tag-channel { background-color: #7ED321; }
.tag-bank { background-color: #BD10E0; }

.item-date { font-size: 22rpx; color: #999; margin-bottom: 4rpx; }
.item-right { display: flex; flex-direction: column; align-items: flex-end; }
.item-note { font-size: 20rpx; margin-top: 4rpx; }

.date-divider {
  padding: 16rpx 0 8rpx 0;
  border-bottom: 2rpx solid #333;
  margin-bottom: 8rpx;
}
.date-divider-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}
