<view class="container">
  <view class="record-list" wx:if="{{groupedRecords.length}}">
    <block wx:for="{{groupedRecords}}" wx:key="unique">
      <view class="date-divider" wx:if="{{item.isDivider}}">
        <text class="date-divider-text">{{item.date}}</text>
      </view>
      <view class="list-item" wx:else bind:tap="goEdit" data-id="{{item.id}}">
        <view class="item-left">
          <view class="tag-row">
            <text class="tag tag-account" wx:if="{{item.account_name}}">{{item.account_name}}</text>
            <text class="tag tag-category" wx:if="{{item.category_name}}">{{item.category_name}}</text>
            <text class="tag tag-channel" wx:if="{{item.channel_name}}">{{item.channel_name}}</text>
            <text class="tag tag-bank" wx:if="{{item.bank_name}}">{{item.bank_name}}</text>
          </view>
        </view>
        <view class="item-right">
          <text class="item-amount text-expense">-¥{{item.amount}}</text>
          <text class="item-note text-muted" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{!records.length && !loading}}">
    <van-empty description="暂无支出记录" />
  </view>

  <van-loading wx:if="{{loading}}" size="24px" vertical custom-class="page-loading">加载中...</van-loading>

  <view wx:if="{{!hasMore && records.length}}" class="no-more text-muted">没有更多了</view>
</view>

<view class="fab-btn expense" bind:tap="goAdd">+</view>