<view class="container">
  <view class="card total-card">
    <text class="total-label">本月支出</text>
    <text class="total-amount text-expense">¥{{totalExpense}}</text>
  </view>

  <view class="record-list" wx:if="{{records.length}}">
    <view class="list-item" wx:for="{{records}}" wx:key="id" bind:tap="goEdit" data-id="{{item.id}}">
      <view class="item-left">
        <view class="item-top">
          <text class="item-category">{{item.category_name || '未分类'}}</text>
          <text class="tag expense tag-small">支出</text>
        </view>
        <view class="item-bottom text-muted">
          <text>{{item.record_date || item.date}}</text>
          <text wx:if="{{item.account_name}}" class="ml-10">{{item.account_name}}</text>
        </view>
        <view class="item-bottom text-muted" wx:if="{{item.note}}">
          <text>{{item.note}}</text>
        </view>
      </view>
      <text class="item-amount text-expense">-¥{{item.amount}}</text>
    </view>
  </view>

  <view wx:if="{{!records.length && !loading}}">
    <van-empty description="暂无支出记录" />
  </view>

  <van-loading wx:if="{{loading}}" size="24px" vertical custom-class="page-loading">加载中...</van-loading>

  <view wx:if="{{!hasMore && records.length}}" class="no-more text-muted">没有更多了</view>
</view>

<view class="fab-btn expense" bind:tap="goAdd">+</view>