<view class="container">
  <view class="amount-card card">
    <text class="amount-label">支出金额</text>
    <view class="amount-input-wrap">
      <text class="amount-prefix text-expense">¥</text>
      <input class="amount-input text-expense" type="digit" placeholder="0.00" value="{{form.amount}}" bindinput="onAmountInput" focus="{{!isEdit}}" />
    </view>
  </view>

  <van-cell-group>
    <van-cell title="日期" is-link value="{{form.date || '请选择'}}" bind:click="noop">
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange" slot="extra">
        <view class="picker-trigger"></view>
      </picker>
    </van-cell>

    <van-cell title="账本" is-link>
      <view slot="title" style="display:flex;align-items:center;flex-wrap:wrap;">
        <view class="account-tag" wx:for="{{selectedAccounts}}" wx:key="id" wx:for-item="acc" style="margin:2px 4px;">
          <text style="font-size:22rpx;">{{acc.name}}</text>
          <van-icon name="cross" size="12px" color="#999" bind:click="onAccountRemove" data-index="{{index}}" custom-class="account-tag-remove" />
        </view>
      </view>
      <picker range="{{accountNames}}" value="{{0}}" bindchange="onAccountAdd" slot="extra">
        <view class="picker-trigger"></view>
      </picker>
    </van-cell>

    <van-cell title="分类" is-link value="{{categoryIndex >= 0 ? categoryNames[categoryIndex] : '请选择'}}">
      <picker range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryConfirm" slot="extra">
        <view class="picker-trigger"></view>
      </picker>
    </van-cell>

    <van-cell title="渠道" is-link value="{{channelIndex >= 0 ? channelNames[channelIndex] : '可选'}}">
      <picker range="{{channelNames}}" value="{{channelIndex}}" bindchange="onChannelConfirm" slot="extra">
        <view class="picker-trigger"></view>
      </picker>
    </van-cell>

    <van-cell title="银行" is-link value="{{bankIndex >= 0 ? bankNames[bankIndex] : '可选'}}">
      <picker range="{{bankNames}}" value="{{bankIndex}}" bindchange="onBankConfirm" slot="extra">
        <view class="picker-trigger"></view>
      </picker>
    </van-cell>

    <van-field label="备注" value="{{form.note}}" placeholder="选填" border="{{true}}" bind:change="onNoteInput" />
  </van-cell-group>

  <view class="submit-wrap">
    <van-button type="danger" block loading="{{submitting}}" disabled="{{submitting}}" bind:click="onSubmit">
      {{isEdit ? '保存修改' : '记一笔支出'}}
    </van-button>
  </view>
</view>