<view class="container">
  <view class="amount-card card">
    <text class="amount-label">支出金额</text>
    <view class="amount-input-wrap">
      <text class="amount-prefix text-expense">¥</text>
      <input class="amount-input text-expense" type="digit" placeholder="0.00" value="{{form.amount}}" bindinput="onAmountInput" focus="{{!isEdit}}" />
    </view>
  </view>

  <view class="form-group">
    <view class="form-row">
      <text class="form-label">日期</text>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <text class="form-value">{{form.date || '请选择'}}</text>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">账本</text>
      <view class="form-right">
        <view class="account-tags">
          <view class="account-tag" wx:for="{{selectedAccounts}}" wx:key="id" wx:for-item="acc">
            <text>{{acc.name}}</text>
            <text class="account-tag-del" bind:tap="onAccountRemove" data-index="{{index}}"> x</text>
          </view>
        </view>
        <picker range="{{accountNames}}" bindchange="onAccountAdd">
          <text class="form-add">+ 添加</text>
        </picker>
      </view>
    </view>

    <view class="form-row">
      <text class="form-label">分类</text>
      <picker range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryConfirm">
        <text class="form-value">{{categoryNames[categoryIndex] || '请选择'}}</text>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">渠道</text>
      <picker range="{{channelNames}}" value="{{channelIndex}}" bindchange="onChannelConfirm">
        <text class="form-value">{{channelNames[channelIndex] || '可选'}}</text>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">银行</text>
      <picker range="{{bankNames}}" value="{{bankIndex}}" bindchange="onBankConfirm">
        <text class="form-value">{{bankNames[bankIndex] || '可选'}}</text>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">备注</text>
      <input class="form-input" value="{{form.note}}" placeholder="选填" bindinput="onNoteInput" />
    </view>
  </view>

  <view class="submit-wrap">
    <van-button type="danger" block loading="{{submitting}}" disabled="{{submitting}}" bind:click="onSubmit">
      {{isEdit ? '保存修改' : '记一笔支出'}}
    </van-button>
  </view>

  <view class="delete-wrap" wx:if="{{isEdit}}">
    <van-button type="default" block bind:click="onDelete" custom-class="delete-btn">删除记录</van-button>
  </view>
</view>