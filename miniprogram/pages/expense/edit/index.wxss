.amount-card {
  text-align: center;
  padding: 30rpx;
}

.amount-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}

.amount-prefix {
  font-size: 48rpx;
  font-weight: bold;
  margin-right: 8rpx;
}

.amount-input {
  font-size: 72rpx;
  font-weight: bold;
  min-width: 200rpx;
  height: 100rpx;
}

.form-group {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  min-height: 50rpx;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
  width: 100rpx;
}

.form-value {
  font-size: 28rpx;
  color: #666;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  height: 50rpx;
}

.form-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.form-add {
  font-size: 26rpx;
  color: #4A90D9;
  margin-left: 12rpx;
}

.account-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.account-tag {
  background: #e8f0fe;
  color: #4A90D9;
  font-size: 22rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
}

.account-tag-del {
  color: #999;
  margin-left: 4rpx;
  font-size: 22rpx;
}

.submit-wrap {
  margin-top: 60rpx;
  padding: 0 24rpx;
}