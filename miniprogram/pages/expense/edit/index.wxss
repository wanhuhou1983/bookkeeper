.amount-card {
  text-align: center;
  padding: 30rpx;
}

.amount-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}

.amount-prefix {
  font-size: 48rpx;
  font-weight: bold;
  margin-right: 8rpx;
}

.amount-input {
  font-size: 72rpx;
  font-weight: bold;
  min-width: 200rpx;
}

.submit-wrap {
  margin-top: 60rpx;
  padding: 0 10rpx;
}

/* 多账本标签 */
.account-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 8rpx 0;
}

.account-tag {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 24rpx;
  color: #333;
}

.account-tag-name {
  margin-right: 6rpx;
}

.account-tag-remove {
  margin-left: 2rpx;
}

.account-tag.account-add {
  background: #e8f0fe;
  padding: 6rpx 14rpx;
}

/* 账本选择弹窗 */
.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}

.picker-title {
  font-size: 30rpx;
  font-weight: bold;
}

.picker-list {
  padding: 16rpx 0;
}

.picker-item {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.picker-item:active {
  background: #f5f5f5;
}