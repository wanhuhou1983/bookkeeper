.amount-card {
  text-align: center;
  padding: 30rpx;
}

.amount-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}

.amount-prefix {
  font-size: 48rpx;
  font-weight: bold;
  margin-right: 8rpx;
}

.amount-input {
  font-size: 72rpx;
  font-weight: bold;
  min-width: 200rpx;
}

.submit-wrap {
  margin-top: 60rpx;
  padding: 0 10rpx;
}

.account-tag {
  display: inline-flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
}

.account-tag-remove {
  margin-left: 4rpx;
}

.picker-trigger {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}